# Copy this file to .env.local and fill in the real values from your
# Supabase project (Project Settings → API). This is the SAME Supabase
# project used by your existing NDIS Staff Portal — reuse those values.
#
# Without these, supabaseClient.js will fail to connect and the app
# will show empty participants / a console error on load.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
